# ---------- Site ----------
# Public site URL (metadata, sitemap, OG, auth + payment redirect URLs)
NEXT_PUBLIC_SITE_URL=https://gravityystudio.com
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Analytics is skipped when empty.
NEXT_PUBLIC_GA_ID=

# ---------- Supabase (Auth + Postgres: CMS, plans, invoices) ----------
# Without these the marketing site runs on data/*.json and /login shows a setup notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (webhooks, form intake, rate limiting). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: HMAC key for IPs stored on consent records (openssl rand -hex 32). Unset = no IP stored.
IP_HASH_SECRET=
# Optional, PAID: Google Places for "Run discovery". Leave empty until approved.
GOOGLE_PLACES_API_KEY=

# ---------- Payments ----------
# GLOBAL billing (USD) → Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IN billing (INR + GST) → Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email (Resend) ----------
# When empty, form + invoice emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=Gravityy Studio <noreply@gravityystudio.com>
EMAIL_TO=hello@gravityystudio.com

# ---------- Site ----------
# Public site URL (metadata, sitemap, OG, auth + payment redirect URLs)
NEXT_PUBLIC_SITE_URL=https://gravityystudio.com
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Analytics is skipped when empty.
NEXT_PUBLIC_GA_ID=

# ---------- Supabase (Auth + Postgres: CMS, plans, invoices) ----------
# Without these the marketing site runs on data/*.json and /login shows a setup notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (webhooks, form intake, rate limiting). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: HMAC key for IPs stored on consent records (openssl rand -hex 32). Unset = no IP stored.
IP_HASH_SECRET=
# Optional, PAID: Google Places for "Run discovery". Leave empty until approved.
GOOGLE_PLACES_API_KEY=
# Free audit: Google PageSpeed Insights API key (free; Google Cloud → enable "PageSpeed Insights API" → API key,
# restricted to that API). Without it Google allows only a few runs a day, so audits would often miss their speed scores.
PAGESPEED_API_KEY=

# ---------- n8n automation (see n8n/README.md) ----------
# Empty = automation off: events wait in the outbox, /api/automation returns 503.
N8N_WEBHOOK_BASE_URL=
# openssl rand -hex 32 — different values for app→n8n and n8n→app, and per environment.
N8N_OUTBOUND_SECRET=
N8N_CALLBACK_SECRET=
# Outbound email stays off until the owner approves it (also needs the Gmail node enabled in n8n).
OUTREACH_SENDING_ENABLED=false
OUTREACH_DAILY_LIMIT=20
# Optional, PAID: Reoon email verification for inbound leads. Leave empty until approved.
REOON_API_KEY=

# ---------- Payments ----------
# GLOBAL billing (USD) → Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IN billing (INR + GST) → Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email (Resend) ----------
# When empty, form + invoice emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=Gravityy Studio <noreply@gravityystudio.com>
EMAIL_TO=hello@gravityystudio.com
